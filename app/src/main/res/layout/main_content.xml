</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/faBtnStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:text="@string/location_start" app:icon="@drawable/ic_position" app:iconGravity="textStart" app:cornerRadius="18dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/location_stop" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="10dp" android:text="@string/location_stop" android:visibility="gone" app:cornerRadius="18dp"/>
</LinearLayout>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<LinearLayout app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:id="@+id/search_linear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="88dp" android:layout_marginHorizontal="16dp" android:background="@drawable/panel_surface" android:elevation="8dp" android:visibility="gone"><ListView android:id="@+id/search_list_view" android:layout_width="match_parent" android:layout_height="280dp" android:padding="8dp" android:divider="@color/outline_soft" android:dividerHeight="1dp"/></LinearLayout>
<LinearLayout app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:id="@+id/search_history_linear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="88dp" android:layout_marginHorizontal="16dp" android:background="@drawable/panel_surface" android:elevation="8dp" android:visibility="gone"><ListView android:id="@+id/search_history_list_view" android:layout_width="match_parent" android:layout_height="280dp" android:padding="8dp" android:divider="@color/outline_soft" android:dividerHeight="1dp"/></LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>