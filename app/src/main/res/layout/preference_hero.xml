<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/panel_surface">
    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" app:srcCompat="@mipmap/ic_launcher_round"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
        <TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_main"/>
        <TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/text_muted"/>
    </LinearLayout>
</LinearLayout>
