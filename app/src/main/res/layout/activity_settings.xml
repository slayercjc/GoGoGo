<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/page_background">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize" android:background="@color/page_background"
        app:title="@string/app_settings" app:titleTextColor="@color/text_main"
        app:navigationIconTint="@color/colorPrimary"/>
    <FrameLayout android:id="@+id/settings" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
