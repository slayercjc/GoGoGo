<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/page_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="32dp">
        <ImageView android:layout_width="112dp" android:layout_height="112dp" android:layout_marginTop="24dp" android:contentDescription="@string/app_name" app:srcCompat="@mipmap/ic_launcher_round"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/app_name" android:textSize="38sp" android:textStyle="bold" android:textColor="@color/text_main"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/brand_tagline" android:textSize="16sp" android:textColor="@color/text_muted"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" app:cardCornerRadius="24dp" app:cardBackgroundColor="@color/brand_container" app:strokeWidth="0dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:text="@string/welcome_description" android:textColor="@color/brand_text" android:textSize="15sp" android:lineSpacingExtra="6dp"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp" android:text="@string/welcome_btn_txt" app:cornerRadius="18dp"/>
        <CheckBox android:id="@+id/check_agreement" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:gravity="center_vertical" android:text="@string/app_agreement_privacy" android:textSize="13sp" android:textColor="@color/text_muted"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/brand_developer" android:textSize="12sp" android:textColor="@color/text_muted"/>
    </LinearLayout>
</ScrollView>
