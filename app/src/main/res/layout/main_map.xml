<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
<com.baidu.mapapi.map.MapView android:id="@+id/bdMapView" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true"/>
<RadioGroup android:id="@+id/RadioGroupMapType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="88dp" android:layout_marginEnd="16dp" android:paddingHorizontal="12dp" android:orientation="horizontal" android:background="@drawable/panel_surface" android:elevation="2dp">
<RadioButton android:id="@+id/mapNormal" android:layout_width="wrap_content" android:layout_height="48dp" android:checked="true" android:text="@string/map_pic_normal" android:textColor="@color/text_main"/>
<RadioButton android:id="@+id/mapSatellite" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/map_pic_sate" android:textColor="@color/text_main"/>
</RadioGroup>
<LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end|bottom" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp" android:orientation="horizontal" android:background="@drawable/panel_surface" android:elevation="2dp">
<ImageButton android:id="@+id/cur_position" style="@style/HuanWei.MapButton" android:contentDescription="@string/cur_position" app:srcCompat="@drawable/ic_home_position" app:tint="@color/colorPrimary"/>
<ImageButton android:id="@+id/input_pos" style="@style/HuanWei.MapButton" android:contentDescription="@string/input_button" app:srcCompat="@drawable/ic_input" app:tint="@color/colorPrimary"/>
<ImageButton android:id="@+id/zoom_in" style="@style/HuanWei.MapButton" android:contentDescription="@string/zoom_in" app:srcCompat="@drawable/ic_zoom_in" app:tint="@color/colorPrimary"/>
<ImageButton android:id="@+id/zoom_out" style="@style/HuanWei.MapButton" android:contentDescription="@string/zoom_out" app:srcCompat="@drawable/ic_zoom_out" app:tint="@color/colorPrimary"/>
</LinearLayout>
</FrameLayout>